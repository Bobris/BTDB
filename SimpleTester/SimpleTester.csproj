<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8"/>
        <PackageReference Include="Disruptor" Version="6.0.1"/>
        <PackageReference Include="FluentAssertions" Version="8.10.0"/>
        <PackageReference Include="HdrHistogram" Version="2.5.0"/>
        <PackageReference Include="protobuf-net" Version="3.4.21"/>
        <PackageReference Include="TerraFX.Interop.Mimalloc" Version="1.6.7.2"/>
        <PackageReference Include="XXHash.Managed" Version="1.5.2"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\BTDB\BTDB.csproj"/>
        <ProjectReference Include="..\BTDBTest\BTDBTest.csproj"/>
    </ItemGroup>
</Project>
