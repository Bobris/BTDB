<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>true</IsPackable>
        <PackageId>BTDB.Replication.EventSourcing</PackageId>
        <Version>35.13.0</Version>
        <PackageVersion>$(Version)-preview</PackageVersion>
        <Authors>Boris Letocha</Authors>
        <PackageProjectUrl>https://github.com/Bobris/BTDB</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>Typed event publishing, synchronous validation, Layer2 serialization, ambient ObjectDB transactions and replay over BTDB replication and EventLog.</Description>
        <PackageTags>BTDB replication EventLog event sourcing ObjectDB</PackageTags>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>embedded</DebugType>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <RepositoryUrl>https://github.com/Bobris/BTDB.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../BTDB.Replication/BTDB.Replication.csproj" />
        <ProjectReference Include="../BTDB.SourceGenerator/BTDB.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <None Include="README.md" Pack="true" PackagePath="/" />
        <InternalsVisibleTo Include="BTDB.Replication.EventSourcing.Test" />
    </ItemGroup>
</Project>
